#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""在 TCL 电视上播放本地视频（电视自己解码，不镜像、不占本机屏幕）。

用法:
  tv-play 视频文件...          播放（给多个文件/目录 = 按顺序连播，播完自动下一个）
  tv-play -f 12:30 视频...     从 12:30 开始播
  tv-play --sub auto 视频...   把字幕烧进画面再播（默认不烧，见下面「字幕」）
  tv-play pause|resume         暂停 / 继续
  tv-play seek 12:30 | 90      拖动到指定位置（也支持 -30 / +30 相对拖动）
  tv-play next                 切到下一个（下一个文件/目录里的下一个）
  tv-play status               当前状态 + 进度
  tv-play stop                 停止播放，电视回桌面

原理: 本机起 HTTP 服务（支持 Range，拖动必须），SSDP 找到电视的 MediaRenderer，
AVTransport SetAVTransportURI + Play。电视端由
com.tcl.MultiScreenInteraction_TV 的 PresentationActivity 播放。

两个实测出来的电视端限制（所以才有这个脚本的守护进程）:
  * GetCurrentTransportActions 返回空、SetNextAVTransportURI 直接 401 → 电视没有"下一集"，
    连播是我们每 2 秒轮询播放状态、播完再推下一个文件实现的
  * RenderingControl.SetVolume 返回 200 但音量不变 → 音量只能电视遥控器调

字幕（默认关，开了要重编码）: DLNA 这条链路没有字幕通道，外挂 .srt/.ass 电视端看不到。
  想有字幕只能用 ffmpeg 把字幕烧进画面再推流: --sub auto（自动找同名外挂字幕，没有就用
  内嵌、中文优先）/ --sub 字幕文件 / -t chi（指定内嵌字幕流）。代价是这个文件要整个重新
  编码一遍（CPU 满转、要临时磁盘），所以默认不开，且播放列表里下一个文件会在当前文件
  播放时后台预先转好。转发失败就退回原片（只是没字幕）。
参考: ~/IdeaProjects/book/src/yancc/tcl/TCL电视投屏.md
"""

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.error

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import tv_dlna as d                                    # noqa: E402

TAG = "tv-play"
SKIP = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "tv-play.skip")
REPLAY = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "tv-play.replay")
VIDEO = {
    ".mp4": ("video/mp4", "AVC_MP4_HP_HD_AAC"), ".m4v": ("video/mp4", "AVC_MP4_HP_HD_AAC"),
    ".mkv": ("video/x-matroska", ""), ".webm": ("video/webm", ""),
    ".avi": ("video/x-msvideo", ""), ".mov": ("video/quicktime", ""),
    ".ts": ("video/mp2t", ""), ".m2ts": ("video/mp2t", ""),
    ".flv": ("video/x-flv", ""), ".wmv": ("video/x-ms-wmv", ""),
    ".rmvb": ("video/vnd.rn-realmedia-vbr", ""), ".mpg": ("video/mpeg", ""),
    ".mpeg": ("video/mpeg", ""), ".3gp": ("video/3gpp", ""),
}


def collect(paths):
    out = []
    for p in paths:
        p = os.path.abspath(os.path.expanduser(p))
        if os.path.isdir(p):
            names = sorted((n for n in os.listdir(p)
                            if os.path.splitext(n)[1].lower() in VIDEO),
                           key=lambda n: [int(t) if t.isdigit() else t.lower()
                                          for t in re.split(r"(\d+)", n)])
            for n in names:
                f = os.path.join(p, n)
                if os.path.isfile(f):
                    out.append((f,) + VIDEO[os.path.splitext(f)[1].lower()])
        elif os.path.isfile(p):
            ext = os.path.splitext(p)[1].lower()
            if ext not in VIDEO:
                d.log(TAG, "跳过（不是认识的视频）: %s" % p)
                continue
            out.append((p,) + VIDEO[ext])
        else:
            d.log(TAG, "跳过（不存在）: %s" % p)
    return out


# ------------------------------------------------------------------ 字幕烧录（可选）
# DLNA 没有字幕通道 → 想有字幕只能把字幕烧进画面（重编码成 mp4）。默认关，
# 开了以后每个要烧的文件先在本地转一份放到 ~/.cache/tv-play/<pid>/，再推给电视。
SUBS_EXT = (".srt", ".ass", ".ssa", ".vtt", ".sub")
SUBS_EXT_RANK = {".srt": 0, ".ass": 1, ".ssa": 2, ".vtt": 3, ".sub": 4}
ZH_TAGS = ("zh", "chi", "zho", "chs", "cht", "cn", "sc", "tc", "简", "繁", "中")
MP4_AUDIO = ("aac", "mp3", "ac3", "eac3", "alac")      # 能直接 -c:a copy 进 mp4 的音频
BITMAP_SUBS = ("hdmv_pgs_subtitle", "dvd_subtitle", "dvb_subtitle", "xsub")  # 图形字幕，烧不了
VAAPI_DEVICE = os.environ.get("TCL_VAAPI_DEVICE", "/dev/dri/renderD128")
CACHE_DIR = os.environ.get("TCL_PLAY_CACHE",
                           os.path.join(os.path.expanduser("~/.cache"), "tv-play"))


class Cancelled(Exception):
    """tv-play stop/退出时把正在跑的转码中断掉，走这个异常（不当失败处理）。"""


def probe_streams(path):
    """ffprobe 列出所有流 → [{index,type,codec,lang,title}]（探测失败返回 []）。"""
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries",
             "stream=index,codec_type,codec_name:stream_tags=language,title",
             "-of", "json", path],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=30).stdout
        streams = json.loads(out).get("streams", [])
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    res = []
    for s in streams:
        tags = s.get("tags") or {}
        res.append({"index": s.get("index"), "type": s.get("codec_type"),
                    "codec": s.get("codec_name") or "",
                    "lang": (tags.get("language") or "").strip(),
                    "title": (tags.get("title") or "").strip()})
    return res


def probe_duration(path):
    """片长（秒），拿不到就 0（只影响进度百分比显示）。"""
    try:
        out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                              "-of", "csv=p=0", path],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             text=True, timeout=30).stdout.strip()
        return float(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0.0


def probe_audio_codec(path):
    streams = [s for s in probe_streams(path) if s["type"] == "audio"]
    return streams[0]["codec"] if streams else ""


def external_subtitle(video):
    """找同名外挂字幕: movie.srt / movie.zh.srt / movie.chs.ass …（中文优先）。"""
    folder = os.path.dirname(video) or "."
    base = os.path.splitext(os.path.basename(video))[0]
    try:
        names = os.listdir(folder)
    except OSError:
        return None
    best = None
    for n in names:
        ext = os.path.splitext(n)[1].lower()
        if ext not in SUBS_EXT:
            continue
        stem = n[:-len(ext)]
        if stem != base and not stem.startswith(base + "."):    # 必须是同名的（可带语言后缀）
            continue
        lang = stem[len(base):].lstrip(".").lower()
        key = (0 if any(t in lang for t in ZH_TAGS) else 1, SUBS_EXT_RANK.get(ext, 9), n)
        if best is None or key < best[0]:
            best = (key, os.path.join(folder, n))
    return best[1] if best else None


def embedded_subtitle(video, track=""):
    """选一条内嵌字幕流，返回 {index, si, label}。

    index = ffprobe 里那条流的全局序号（给人看、给 --track 用）；
    si = subtitles 滤镜要的序号，它是"第几条字幕流"（从 0 数，实测），不是全局序号。
    track 给序号/语言就按它选，否则中文优先、再第一条文本字幕；图形字幕(PGS/DVD)烧不了。
    """
    subs = [s for s in probe_streams(video) if s["type"] == "subtitle"]
    text = [s for s in subs if s["codec"] not in BITMAP_SUBS]
    hit = None
    if track:
        t = track.lower()
        if track.isdigit():
            n = int(track)
            hit = next((s for s in subs if s["index"] == n), None)      # 先按全局序号
            if hit is None and 0 <= n < len(subs):                      # 再接受"第几条字幕"
                hit = subs[n]
            if hit and hit["codec"] in BITMAP_SUBS:
                d.log(TAG, "字幕流 %s 是图形字幕(%s)，烧不了，跳过" % (track, hit["codec"]))
                return None
        else:
            hit = next((s for s in text if t in (s["lang"] + " " + s["title"]).lower()), None)
    elif text:
        zh = [s for s in text if any(x in (s["lang"] + " " + s["title"]).lower() for x in ZH_TAGS)]
        hit = (zh or text)[0]
    if not hit:
        return None
    return {"index": hit["index"],
            "si": next(i for i, s in enumerate(subs) if s["index"] == hit["index"]),
            "label": hit["title"] or hit["lang"] or ("字幕流 %d" % hit["index"])}


def burn_plan(video, opt):
    """这个文件要不要烧字幕、怎么烧；返回 None = 不烧，原样推流。"""
    mode, track = opt["sub"], opt["track"]
    if mode not in ("none", "auto"):                    # --sub 直接给了字幕文件
        return {"kind": "external", "file": os.path.abspath(mode)}
    if mode == "none" and not track:
        return None
    if mode == "auto":
        ext = external_subtitle(video)
        if ext:
            return {"kind": "external", "file": ext}
    emb = embedded_subtitle(video, track)
    if emb:
        return {"kind": "embedded", "si": emb["si"], "index": emb["index"], "label": emb["label"]}
    return None


_FILTER_ESCAPE = "\\'[]:;,"


def esc_filter(path):
    """ffmpeg 滤镜参数里写路径要转义（冒号、逗号、方括号、单引号…）。"""
    return "".join("\\" + c if c in _FILTER_ESCAPE else c for c in path)


def spec_text(spec, video):
    if spec["kind"] == "external":
        return os.path.basename(spec["file"])
    return "内嵌字幕「%s」" % spec["label"]


def vf_chain(video, spec, opt):
    """字幕用 subtitles 滤镜烧进画面；外挂给文件名，内嵌给片源 + si=流序号。"""
    if spec["kind"] == "external":
        chain = ["subtitles=%s" % esc_filter(spec["file"])]
    else:
        chain = ["subtitles=%s:si=%d" % (esc_filter(video), spec["si"])]
    if opt["size"]:
        chain.append("scale=%d:%d" % opt["size"])
    if opt["encoder"].endswith("_vaapi"):
        chain += ["format=nv12", "hwupload"]
    return ",".join(chain)


def ffmpeg_cmd(video, dst, spec, opt, audio_args):
    args = ["ffmpeg", "-hide_banner", "-nostdin", "-y", "-loglevel", "error",
            "-progress", "pipe:1", "-nostats"]
    if opt["encoder"].endswith("_vaapi"):
        args += ["-vaapi_device", VAAPI_DEVICE]
    args += ["-i", video, "-map", "0:v:0", "-map", "0:a:0?", "-sn",
             "-vf", vf_chain(video, spec, opt)]
    if opt["encoder"] == "libx264":
        args += ["-c:v", "libx264", "-preset", opt["preset"], "-crf", str(opt["crf"]),
                 "-pix_fmt", "yuv420p"]
    else:
        args += ["-c:v", opt["encoder"], "-qp", str(opt["crf"])]
    args += audio_args + ["-movflags", "+faststart", dst]
    return args


def parse_size(text):
    if not text:
        return None
    parts = re.split(r"[xX:]", text.strip())
    if len(parts) != 2:
        raise SystemExit("--size 要写成 1280x720（宽x高）")
    try:
        return (int(parts[0]), int(parts[1]))
    except ValueError:
        raise SystemExit("--size 的宽高要是数字，如 1280x720")


def prune_cache(keep):
    """清掉以前跑崩留下的转码残留（子目录名就是 PID，进程还活着的留着）。"""
    try:
        entries = os.listdir(CACHE_DIR)
    except OSError:
        return
    for name in entries:
        path = os.path.join(CACHE_DIR, name)
        if name == keep or not os.path.isdir(path):
            continue
        if name.isdigit() and d.pid_alive(int(name)):
            continue
        shutil.rmtree(path, ignore_errors=True)


class Burner(threading.Thread):
    """按需把文件转成「字幕已烧进画面」的临时 mp4；单线程串行转，转好放进 served。"""

    def __init__(self, files, opt, served, tmpdir):
        super().__init__(daemon=True)
        self.files, self.opt, self.served, self.tmpdir = files, opt, served, tmpdir
        self.cv = threading.Condition()
        self.queue, self.done, self.plans = [], {}, {}
        self.proc, self.stopping = None, False

    def _original(self, idx):
        path, mime, profile = self.files[idx]
        return {"url": "/v/%d%s" % (idx, os.path.splitext(path)[1].lower()),
                "file": path, "mime": mime, "profile": profile,
                "label": os.path.basename(path), "burned": False}

    def plan(self, idx):
        if idx not in self.plans:
            try:
                self.plans[idx] = burn_plan(self.files[idx][0], self.opt)
            except Exception as e:                      # noqa: BLE001
                d.log(TAG, "字幕探测失败（%s），这个文件原样播" % e)
                self.plans[idx] = None
        return self.plans[idx]

    def needs(self, idx):
        return 0 <= idx < len(self.files) and self.plan(idx) is not None

    def prefetch(self, idx):
        """提前把第 idx 个排上（当前文件在播时，后台先把下一个转好）。"""
        if not (0 <= idx < len(self.files)):
            return
        if not self.needs(idx):
            self.done[idx] = self._original(idx)
            return
        with self.cv:
            if idx in self.done or idx in self.queue:
                return
            self.queue.append(idx)
            self.cv.notify_all()

    def ensure(self, idx):
        """第 idx 个可以播的信息；要烧字幕就在这里等它转完。"""
        self.prefetch(idx)
        with self.cv:
            while idx not in self.done:
                self.cv.wait(0.5)
            return self.done[idx]

    def stop(self):
        """停掉调度线程和正在跑的 ffmpeg（不然 tv-play stop 会留下转码进程占 CPU）。"""
        with self.cv:
            self.stopping = True
            self.queue.clear()
            self.cv.notify_all()
        deadline = time.time() + 10
        while time.time() < deadline:
            self._kill(self.proc)
            if not self.is_alive():
                return
            time.sleep(0.1)
        self._kill(self.proc)
        self.join(timeout=3)

    @staticmethod
    def _kill(proc):
        """转码的 ffmpeg 单独一个进程组，整组杀干净（SIGKILL，别等它写完）。"""
        if not proc or proc.poll() is not None:
            return
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except OSError:
            try:
                proc.kill()
            except OSError:
                pass

    def run(self):
        while True:
            with self.cv:
                while not self.queue and not self.stopping:
                    self.cv.wait()
                if self.stopping:
                    return
                idx = self.queue.pop(0)
            media = self._burn(idx)
            with self.cv:
                self.done[idx] = media
                self.cv.notify_all()

    def _burn(self, idx):
        spec, video = self.plan(idx), self.files[idx][0]
        if not spec or self.stopping:
            return self._original(idx)
        dst = os.path.join(self.tmpdir, "%03d.burn.mp4" % idx)
        try:
            self._transcode(video, dst, spec, idx)
        except Cancelled:
            d.log(TAG, "字幕烧录被取消: %s" % video)
            if os.path.exists(dst):
                os.unlink(dst)
            return self._original(idx)
        except Exception as e:                          # noqa: BLE001
            d.log(TAG, "字幕烧录失败（%s），这个文件原样播: %s" % (e, video))
            d.note(TAG, "字幕烧录失败，原样播放", os.path.basename(video))
            if os.path.exists(dst):
                os.unlink(dst)
            return self._original(idx)
        media = {"url": "/v/%d.burn.mp4" % idx, "file": dst, "mime": "video/mp4",
                 "profile": "AVC_MP4_HP_HD_AAC",
                 "label": os.path.basename(video), "burned": True}
        self.served[media["url"]] = {"file": dst, "mime": media["mime"],
                                     "features": d.features(media["profile"]),
                                     "transfer": "Streaming"}
        return media

    def _transcode(self, video, dst, spec, idx):
        total = probe_duration(video)
        variants = [["-c:a", "aac", "-b:a", "192k"]]
        if probe_audio_codec(video) in MP4_AUDIO:
            variants.insert(0, ["-c:a", "copy"])        # 音频能直接搬就不重编码
        d.log(TAG, "烧录字幕 [%d/%d] %s ← %s" % (idx + 1, len(self.files),
                                                 os.path.basename(video), spec_text(spec, video)))
        d.note(TAG, "正在烧录字幕（重编码）", os.path.basename(video))
        err = ""
        for audio_args in variants:
            if self.stopping:
                raise Cancelled()
            code, err = self._ffmpeg(ffmpeg_cmd(video, dst, spec, self.opt, audio_args), total, idx)
            if code == 0:
                d.log(TAG, "烧录完成: %s（%.0f MB）" % (dst, os.path.getsize(dst) / 1048576))
                return
            if os.path.exists(dst):
                os.unlink(dst)
        if self.stopping:
            raise Cancelled()
        raise RuntimeError((err.strip().splitlines() or ["ffmpeg 非 0 退出"])[-1])

    def _ffmpeg(self, cmd, total, idx):
        d.log(TAG, "ffmpeg: %s" % " ".join("'%s'" % a if " " in a else a for a in cmd))
        self.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                     stdin=subprocess.DEVNULL, text=True, bufsize=1,
                                     start_new_session=True)   # 自己的进程组，stop 时能整组杀
        keys = ("frame=", "fps=", "bitrate=", "total_size=", "out_time=", "out_time_ms=",
                "out_time_us=", "dup_frames=", "drop_frames=", "speed=", "progress=",
                "stream_")
        tail, pct = [], -1
        for line in self.proc.stdout:
            line = line.rstrip("\n")
            if line.startswith("out_time_us=") and total:
                try:
                    p = min(99, int(int(line.split("=", 1)[1]) * 100 / (total * 1000000)))
                except ValueError:
                    continue
                if p >= pct + 10:
                    pct = p - p % 10
                    d.log(TAG, "字幕烧录 %d%%（%d/%d）" % (pct, idx + 1, len(self.files)))
            elif line and not line.startswith(keys):
                tail.append(line)
                del tail[:-20]
        code = self.proc.wait()
        self.proc = None
        return code, "\n".join(tail)


def ctrl_url(wake=False):
    """拿 AVTransport 地址：缓存优先。wake=False 时（暂停/拖动这类控制命令）不折腾电视开机。"""
    cached = d.read_state(TAG).get("avt")
    if cached and d.transport_state(cached) != "OFFLINE":   # 端口每次重启都会变，缓存要探活
        return cached
    return d.discover(TAG, tries=20 if wake else 3, wait=3.0 if wake else 1.0, wake=wake)


def media_key(code, expect, tries=4):
    """遥控键优先的暂停/继续：发键后轮询传输状态确认，成功返回 True。"""
    if not d.media_key(code, TAG):
        return False
    for _ in range(tries):
        time.sleep(1.0)
        if d.transport_state(ctrl_url()) == expect:
            return True
    return False


def send(action, args=None, tries=6, gap=3.0, ready=None):
    """发控制命令。

    这是 DMR 兜底通道：电视的 Pause/Play 时灵时不灵（402 Invalid Args / 701 Transition not
    available），所以暂停/继续优先走 adb 遥控键（media_key），Seek 只有这条通道（实测一直好使）。
    这里以 3 秒间隔重试，第一次被拒时提示用户一声。
    """
    ctrl = ctrl_url()
    if ready:
        for _ in range(12):
            if d.transport_state(ctrl) in ready:
                break
            time.sleep(1.0)
    err = None
    for i in range(tries):
        try:
            return d.soap(ctrl, action, args)[0]
        except urllib.error.HTTPError as e:
            err = e
            detail = d.fault_text(e)
            d.log(TAG, "%s 被拒（%s），当前 %s" % (action, detail, d.transport_state(ctrl)))
            if i == 0:
                print("电视刚开播时会拒 %s（%s），等它缓冲好，最多重试 60 秒…"
                      % (action, detail), file=sys.stderr, flush=True)
            time.sleep(gap)
        except Exception as e:                          # noqa: BLE001
            raise SystemExit("控制电视失败（电视关了？）: %s" % e)
    raise SystemExit("电视拒绝 %s：%s（这个片源/这个时机电视就是不认，试试遥控器）"
                     % (action, d.fault_text(err)))


# ------------------------------------------------------------------ 后台播放
def play_url(idx, files, srv, ctrl, media, from_pos=0):
    url = srv.url(media["url"])
    d.push(ctrl, url, media["mime"], media["profile"], media["label"],
           upnp_class="object.item.videoItem", transfer="Streaming")
    d.log(TAG, "开播 [%d/%d] %s%s" % (idx + 1, len(files), files[idx][0],
                                      "（字幕已烧进画面）" if media["burned"] else ""))
    if from_pos:
        time.sleep(2.0)                                 # 等电视真的开始播再 Seek，早了会被丢掉
        d.soap(ctrl, "Seek", {"InstanceID": 0, "Unit": "REL_TIME",
                              "Target": d.fmt_time(from_pos)})
    d.write_state(TAG, {**d.read_state(TAG), "index": idx, "playing": files[idx][0],
                        "files": len(files), "port": srv.port, "state": "PLAYING"})


def worker(files, from_pos, opt):
    d.write_state(TAG, {**d.read_state(TAG), "pid": os.getpid(), "state": "STARTING"})
    d.kill_daemon("tv-show")                            # 图片和视频抢同一个渲染器，先从图片模式退出来
    ctrl = d.discover(TAG, tries=20, wait=3.0)
    served = {}
    for i, (path, mime, profile) in enumerate(files):
        served["/v/%d%s" % (i, os.path.splitext(path)[1].lower())] = {
            "file": path, "mime": mime, "features": d.features(profile), "transfer": "Streaming"}
    srv = d.Server(served, TAG)
    tmpdir = os.path.join(CACHE_DIR, str(os.getpid()))
    os.makedirs(tmpdir, exist_ok=True)
    prune_cache(str(os.getpid()))
    burner = Burner(files, opt, served, tmpdir)
    burner.start()
    if opt["sub"] != "none" or opt["track"]:
        free = shutil.disk_usage(tmpdir).free
        d.log(TAG, "字幕缓存 %s（剩 %.1f GB）" % (tmpdir, free / 2 ** 30))
        if free < 4 * 2 ** 30:                          # 长片烧一份副本要几个 GB
            d.log(TAG, "警告: 剩余空间不到 4 GB，长片的转码副本可能放不下")
    d.write_state(TAG, {**d.read_state(TAG), "pid": os.getpid(), "avt": ctrl,
                        "port": srv.port, "files": len(files), "index": 0,
                        "state": "STARTING"})
    idx, stopped_reads = 0, 0

    def cue(i, start=0):
        """切到第 i 个：要烧字幕就先等转完（等待期状态写 TRANSCODING），再推给电视。"""
        if burner.needs(i):
            d.write_state(TAG, {**d.read_state(TAG), "state": "TRANSCODING"})
            d.log(TAG, "等字幕烧录完成再开播 [%d/%d] %s" % (i + 1, len(files), files[i][0]))
        play_url(i, files, srv, ctrl, burner.ensure(i), start)
        burner.prefetch(i + 1)

    try:
        cue(0, from_pos)
        while True:
            time.sleep(2.0)
            if os.path.exists(REPLAY):                  # tv-play resume 发现已经播完 → 重推当前文件
                os.unlink(REPLAY)
                cue(idx)
                continue
            if os.path.exists(SKIP):
                # tv-play next：不让电视的 DMR 切（会被拒），由守护进程直接推下一个文件。
                # 用哨兵文件而不是 state 字段 —— 两边都在写 state，会互相覆盖。
                os.unlink(SKIP)
                idx = min(idx + 1, len(files) - 1)
                cue(idx)
                continue
            state = d.transport_state(ctrl)
            if state == "OFFLINE":
                d.log(TAG, "渲染器失联，退出")
                break
            if state in ("STOPPED", "NO_MEDIA_PRESENT"):
                stopped_reads += 1
            else:
                stopped_reads = 0
                rel, _ = d.position(ctrl)
                d.write_state(TAG, {**d.read_state(TAG), "state": state, "rel": rel})
            if stopped_reads >= 2:                      # 连续两次才算真播完，避开开播瞬间的 STOPPED
                stopped_reads = 0
                idx += 1
                if idx >= len(files):
                    d.log(TAG, "播放列表结束（%d 个文件）" % len(files))
                    d.write_state(TAG, {**d.read_state(TAG), "state": "FINISHED", "rel": ""})
                    break
                cue(idx)
    finally:
        burner.stop()
        shutil.rmtree(tmpdir, ignore_errors=True)
        srv.shutdown()
        d.clear_state(TAG, os.getpid())                 # 别留过期的 state 骗下一个命令
        if os.path.exists(SKIP):
            os.unlink(SKIP)


def start(args):
    if d.pid_alive(d.read_state(TAG).get("pid")):
        d.log(TAG, "先停掉正在跑的 tv-play")
        stop(args, quiet=True)
    files = collect(args.paths)
    if not files:
        print("没有可播放的视频（支持 %s）" % " ".join(sorted(VIDEO)), file=sys.stderr)
        return 1
    sub = args.sub
    if sub is None:
        sub = "none"                                      # 只给 -t 时 = 只烧这条内嵌字幕
    if sub not in ("none", "auto"):
        sub = os.path.abspath(os.path.expanduser(sub))
        if not os.path.isfile(sub):
            raise SystemExit("字幕文件不存在: %s" % sub)
        if len(files) > 1:
            print("注意: 这个字幕文件会套到列表里全部 %d 个文件上，对不上就是白烧"
                  % len(files), file=sys.stderr)
    if args.encoder.endswith("_vaapi") and not os.path.exists(VAAPI_DEVICE):
        raise SystemExit("没有 %s，硬件编码用不了，请用 --encoder libx264" % VAAPI_DEVICE)
    opt = {"sub": sub, "track": args.track or "", "encoder": args.encoder,
           "crf": args.quality, "preset": args.preset, "size": parse_size(args.size)}
    d.log(TAG, "待播放 %d 个文件%s" % (len(files),
                                       "，从 %s 开始" % d.fmt_time(args.from_pos) if args.from_pos else ""))
    hint = None
    if sub != "none" or args.track:
        try:
            spec = burn_plan(files[0][0], opt)
        except Exception as e:                          # noqa: BLE001
            d.log(TAG, "字幕探测失败（%s）" % e)
            spec = None
        if spec:
            hint = spec_text(spec, files[0][0])
    if args.foreground:
        print("前台运行（Ctrl-C 结束）")
        worker(files, args.from_pos, opt)
        return 0
    if hint:
        print("第一个文件要烧字幕（%s），要重新编码，开播会慢一点…" % hint,
              file=sys.stderr, flush=True)
    pid = d.daemonize(TAG)
    if pid == 0:
        try:
            worker(files, args.from_pos, opt)
        finally:
            os._exit(0)
    deadline, told = time.time() + (7200 if hint else 120), False
    st = d.read_state(TAG)
    while time.time() < deadline:
        st = d.read_state(TAG)
        if st.get("playing") or not d.pid_alive(pid):
            break
        if st.get("state") == "TRANSCODING" and not told:
            print("正在烧录字幕…进度看 %s/tv-play.log" % d.TV_DIR, file=sys.stderr, flush=True)
            told = True
        time.sleep(0.5)
    if not st.get("playing"):
        print("没能开播（state=%s），看看 %s/tv-play.log" % (st.get("state", "?"), d.TV_DIR),
              file=sys.stderr)
        return 1
    print("已开播：%s%s%s" % (os.path.basename(files[0][0]),
                              "（共 %d 个，播完自动下一个）" % len(files) if len(files) > 1 else "",
                              "（字幕已烧进画面）" if hint else ""))
    d.note(TAG, "电视开始播放", os.path.basename(files[0][0]))
    return 0


# ------------------------------------------------------------------ 控制命令
def stop(args=None, quiet=False):
    st = d.read_state(TAG)
    ctrl = st.get("avt")
    if ctrl:
        try:
            pos = d.position(ctrl)[0]
            d.soap(ctrl, "Stop", {"InstanceID": 0})
            d.log(TAG, "已停止（停在 %s）" % pos)
            time.sleep(1.0)                             # 别在电视回拉数据时把 HTTP 服务关掉
        except Exception as e:                          # noqa: BLE001
            d.log(TAG, "发 Stop 失败（电视可能已经关了）: %s" % e)
    d.kill_daemon(TAG)
    if ctrl and d.transport_state(ctrl) in ("PLAYING", "PAUSED_PLAYBACK", "TRANSITIONING"):
        # DMR Stop 在"开播初期"会被拒，那就照遥控器的做法按一下返回键退出播放器
        d.media_key(4, TAG)
    path = d.state_path(TAG)
    if os.path.exists(path):
        os.unlink(path)
    if not quiet:
        print("已停止播放")
    return 0


def status():
    st = d.read_state(TAG)
    ctrl = st.get("avt")
    if not ctrl:
        print("tv-play 没在跑（tv-play 视频文件… 开始）")
        return 2
    state = d.transport_state(ctrl)
    rel, dur = d.position(ctrl)
    playing = st.get("playing", "-")
    idx = st.get("index")
    total = st.get("files")
    where = " [%s/%s]" % (idx + 1, total) if isinstance(idx, int) and total else ""
    if st.get("state") == "TRANSCODING":
        print("第 %s/%s 个文件正在烧字幕（重编码中，还没开播），进度看 %s/tv-play.log"
              % ((idx + 1) if isinstance(idx, int) else "?", total or "?", d.TV_DIR))
        return 0
    print("%s%s  %s  %s / %s" % (os.path.basename(str(playing)), where, state, rel, dur))
    return 0


def paused_or_stopped(action):
    """命令发之前先看状态：已经停了就别再发（发也是等 60 秒然后报错）。"""
    state = d.transport_state(ctrl_url())
    if action == "pause" and state not in ("PLAYING", "TRANSITIONING"):
        print("电视现在是 %s，不用暂停" % state, file=sys.stderr)
        return True
    if action == "resume" and state in ("STOPPED", "NO_MEDIA_PRESENT"):
        print("电视上的播放已经停了（要重播就再来一次 tv-play 视频文件…）", file=sys.stderr)
        return True
    return False


def resume():
    """继续播放。电视端状态不同处理不一样，别一根筋地发 Play（发多了就是等 60 秒然后报错）。"""
    ctrl = ctrl_url()
    state = d.transport_state(ctrl)
    if state == "PLAYING":
        print("已经在播了")
        return 0
    if state in ("STOPPED", "NO_MEDIA_PRESENT"):
        if not d.read_state(TAG).get("pid"):
            print("电视上的播放已经停了（要重播就再来一次 tv-play 视频文件…）", file=sys.stderr)
            return 1
        open(REPLAY, "w").close()                       # 播完了 → 让守护进程重新推这个文件
        print("这个文件已经停了，已让守护进程重头开始")
        return 0
    if media_key(126, "PLAYING"):
        print("继续播放")
        return 0
    return simple("Play", ready=("PAUSED_PLAYBACK", "TRANSITIONING", "STOPPED"))


def simple(action, args=None, ready=None):
    send(action, args, ready=ready)
    print({"Pause": "已暂停", "Play": "继续播放", "Stop": "已停止",
           "Next": "已切下一个"}.get(action, action))
    return 0


def seek(target):
    ctrl = ctrl_url()
    rel, _ = d.position(ctrl)
    ready = ("PLAYING", "PAUSED_PLAYBACK", "TRANSITIONING")
    if target.startswith(("+", "-")):
        now = d.parse_time(rel) if rel else 0
        delta = d.parse_time(target[1:])
        target = d.fmt_time(max(0, now + (-delta if target[0] == "-" else delta)))
    else:
        target = d.fmt_time(d.parse_time(target))
    send("Seek", {"InstanceID": 0, "Unit": "REL_TIME", "Target": target}, ready=ready)
    print("已拖到 %s" % target)
    return 0


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("pause", "resume", "play", "stop", "status", "next", "seek"):
        cmd, rest = argv[0], argv[1:]
        if cmd == "pause":
            if paused_or_stopped("pause"):
                return 1
            # 127 = KEYCODE_MEDIA_PAUSE；遥控键最可靠，DMR 只在 adb 不可用时兜底
            if media_key(127, "PAUSED_PLAYBACK"):
                print("已暂停")
                return 0
            return simple("Pause", ready=("PLAYING", "PAUSED_PLAYBACK", "TRANSITIONING"))
        if cmd in ("resume", "play"):
            return resume()
        if cmd == "stop":
            return stop()
        if cmd == "status":
            return status()
        if cmd == "next":
            st = d.read_state(TAG)
            if not st.get("avt"):
                raise SystemExit("tv-play 没在跑")
            open(SKIP, "w").close()                     # 守护进程下一轮（≤2 秒）就会推下一个
            print("已通知切下一个")
            return 0
        if cmd == "seek":
            if not rest:
                raise SystemExit("用法: tv-play seek 12:30 | tv-play seek +30 | tv-play seek -30")
            return seek(rest[0])

    ap = argparse.ArgumentParser(description="在 TCL 电视上播放本地视频（DLNA）")
    ap.add_argument("paths", nargs="*", help="视频文件或目录（可多个）")
    ap.add_argument("-f", "--from", dest="from_pos", default="",
                    help="从指定位置开始，如 12:30")
    ap.add_argument("-F", "--foreground", action="store_true", help="前台运行（调试）")
    ap.add_argument("-s", "--sub", default=None, metavar="MODE|FILE",
                    help="烧字幕（默认 none 不烧）: none / auto（自动找同名外挂字幕，"
                         "没有就用内嵌、中文优先）/ 直接给一个字幕文件路径")
    ap.add_argument("-t", "--track", default="", metavar="N|LANG",
                    help="内嵌字幕流：ffprobe 的序号或语言/标题（chi、中文…）；"
                         "只给 -t = 只烧这条内嵌字幕，配 --sub auto 则是「外挂优先、没有再用它」")
    ap.add_argument("-q", "--quality", type=int, default=20, metavar="CRF",
                    help="重编码质量（libx264 的 CRF，默认 20，越小越清晰、文件越大）")
    ap.add_argument("--preset", default="veryfast", help="libx264 preset（默认 veryfast）")
    ap.add_argument("--encoder", default="libx264",
                    choices=("libx264", "h264_vaapi", "hevc_vaapi"),
                    help="重编码编码器（默认 libx264；vaapi 要 /dev/dri/renderD128）")
    ap.add_argument("--size", default="", metavar="WxH",
                    help="烧字幕时顺便缩放，如 1280x720（不填保持原分辨率）")
    a = ap.parse_args()
    a.from_pos = d.parse_time(a.from_pos) if a.from_pos else 0
    if (a.paths[:1] or [""])[0] == "on":
        a.paths = a.paths[1:]
    if not a.paths:
        return status()
    return start(a)


if __name__ == "__main__":
    sys.exit(main())
