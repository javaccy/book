#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""在 TCL 电视上全屏显示图片（一张 / 多张幻灯片），不装 App、不用遥控器。

用法:
  tv-show 图片或目录...        显示（多张 = 循环幻灯片，默认每张 15 秒）
  tv-show -i 30 图片...        幻灯片间隔改成 30 秒
  tv-show --no-loop 图片...    多张只放一遍，放完停在最后一张
  tv-show -F 图片...           前台运行（调试用，Ctrl-C 结束）
  tv-show off                  停止显示，电视回桌面

原理、实测数据和踩坑见 ../TCL电视投屏.md「在电视上显示图片（DLNA 推图）」，
公共部分（SSDP 发现 / SOAP / 带 Range 的 DLNA HTTP 服务）在同目录 tv_dlna.py。

环境变量: TCL_TV_ADDR / TCL_SHOW_INTERVAL / TCL_CEC_WAKE_CMD / TCL_TV_DIR
"""

import argparse
import os
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import tv_dlna as d                                    # noqa: E402

TAG = "tv-show"
# 图片扩展名 → (MIME, DLNA profile)。profile 只影响电视端解码档位，给不准也能放，
# 宁可用 *_LRG（<=4096x4096，电视 4K 够用）。
MIME = {
    ".jpg": ("image/jpeg", "JPEG_LRG"), ".jpeg": ("image/jpeg", "JPEG_LRG"),
    ".jfif": ("image/jpeg", "JPEG_LRG"), ".png": ("image/png", "PNG_LRG"),
    ".bmp": ("image/bmp", ""), ".gif": ("image/gif", ""), ".webp": ("image/webp", ""),
}


def collect(paths):
    """展开目录；目录里的图按名字自然排序（tvimg-2 在 tvimg-10 前面）。"""
    out = []
    for p in paths:
        p = os.path.abspath(os.path.expanduser(p))
        if os.path.isdir(p):
            import re
            names = sorted((n for n in os.listdir(p)
                            if os.path.splitext(n)[1].lower() in MIME),
                           key=lambda n: [int(t) if t.isdigit() else t.lower()
                                          for t in re.split(r"(\d+)", n)])
            for n in names:
                f = os.path.join(p, n)
                if os.path.isfile(f):
                    out.append((f,) + MIME[os.path.splitext(f)[1].lower()])
        elif os.path.isfile(p):
            ext = os.path.splitext(p)[1].lower()
            if ext not in MIME:
                d.log(TAG, "跳过（不是图片）: %s" % p)
                continue
            out.append((p,) + MIME[ext])
        else:
            d.log(TAG, "跳过（不存在）: %s" % p)
    return out


def worker(files, interval, loop):
    d.write_state(TAG, {**d.read_state(TAG), "pid": os.getpid(), "state": "STARTING"})
    d.kill_daemon("tv-play")                           # 和视频模式共用渲染器，先让 tv-play 退场
    ctrl = d.discover(TAG, tries=20, wait=3.0)
    served = {"/i/%d%s" % (i, os.path.splitext(p)[1].lower()):
              {"file": p, "mime": m, "features": d.features(pr), "transfer": "Interactive"}
              for i, (p, m, pr) in enumerate(files)}
    srv = d.Server(served, TAG)
    d.write_state(TAG, {**d.read_state(TAG), "pid": os.getpid(), "avt": ctrl,
                        "port": srv.port, "files": len(files), "state": "SHOWING"})
    try:
        for i, (path, mime, profile) in enumerate(files):
            url = srv.url("/i/%d%s" % (i, os.path.splitext(path)[1].lower()))
            d.push(ctrl, url, mime, profile, os.path.basename(path),
                   upnp_class="object.item.imageItem.photo", transfer="Interactive")
            d.log(TAG, "已推送 [%d/%d] %s" % (i + 1, len(files), path))
            if i + 1 < len(files) or (loop and len(files) > 1):
                time.sleep(interval)
        if len(files) == 1:
            d.log(TAG, "单张模式，保持显示（tv-show off 结束）")
        elif loop:
            while True:                                # 循环：整轮放完再从第一张开始
                for i, (path, mime, profile) in enumerate(files):
                    url = srv.url("/i/%d%s" % (i, os.path.splitext(path)[1].lower()))
                    d.push(ctrl, url, mime, profile, os.path.basename(path),
                           upnp_class="object.item.imageItem.photo", transfer="Interactive")
                    d.log(TAG, "已推送 [%d/%d] %s" % (i + 1, len(files), path))
                    time.sleep(interval)
        else:
            d.log(TAG, "幻灯片放完（--no-loop），停在最后一张")
        threading.Event().wait()                        # HTTP 服务留着，电视可能重新拉图
    except KeyboardInterrupt:
        pass
    finally:
        srv.shutdown()
        d.clear_state(TAG, os.getpid())


def start(args):
    if d.pid_alive(d.read_state(TAG).get("pid")):
        d.log(TAG, "已有 tv-show 在跑，先停掉旧的")
        stop(quiet=True)
    files = collect(args.paths)
    if not files:
        print("没有可显示的图片（支持 %s）" % ", ".join(sorted(MIME)), file=sys.stderr)
        return 1
    d.log(TAG, "待显示 %d 张图，间隔 %.1fs，循环=%s" % (len(files), args.interval, not args.no_loop))
    if args.foreground:
        print("前台运行（Ctrl-C 结束）")
        worker(files, args.interval, not args.no_loop)
        os.path.exists(d.state_path(TAG)) and os.unlink(d.state_path(TAG))
        return 0
    pid = d.daemonize(TAG)
    if pid == 0:
        try:
            worker(files, args.interval, not args.no_loop)
        finally:
            os._exit(0)
    st = d.wait_ready(TAG, pid, "avt", timeout=60)
    if not st.get("avt"):
        print("没能在电视上开始显示，看看 %s/tv-show.log" % d.TV_DIR, file=sys.stderr)
        return 1
    if len(files) == 1:
        print("已在电视上显示 1 张图片（保持显示），停止: tv-show off")
    else:
        print("已在电视上显示 %d 张图片（每张 %.0f 秒%s），停止: tv-show off"
              % (len(files), args.interval, "" if not args.no_loop else "，只放一遍"))
    d.note(TAG, "电视显示图片", "%d 张" % len(files))
    return 0


def stop(quiet=False):
    st = d.read_state(TAG)
    ctrl = st.get("avt")
    try:
        if not ctrl:
            ctrl = d.discover(TAG, tries=2, wait=1.0, wake=False)
        d.soap(ctrl, "Stop", {"InstanceID": 0})
        d.log(TAG, "已发 AVTransport Stop")
        time.sleep(1.5)                                 # 给电视一点时间，别在它回拉图片时把服务关掉
    except Exception as e:                              # noqa: BLE001 - 电视关了就别报错
        d.log(TAG, "发 Stop 失败（电视可能已经关了）: %s" % e)
    d.kill_daemon(TAG)
    if os.path.exists(d.state_path(TAG)):
        os.unlink(d.state_path(TAG))
    if not quiet:
        print("已停止显示")
        d.note(TAG, "电视显示图片", "已停止")
    return 0


def main():
    ap = argparse.ArgumentParser(description="把图片推到 TCL 电视全屏显示")
    ap.add_argument("paths", nargs="*", help="图片文件或目录")
    ap.add_argument("-i", "--interval", type=float,
                    default=float(os.environ.get("TCL_SHOW_INTERVAL", 15)),
                    help="幻灯片间隔秒数（默认 15）")
    ap.add_argument("--no-loop", action="store_true", help="多张只放一遍")
    ap.add_argument("-F", "--foreground", action="store_true", help="前台运行（调试）")
    a = ap.parse_args()

    if a.paths and a.paths[0] == "on":
        a.paths = a.paths[1:]
    if a.paths and a.paths[0] == "off":
        return stop()
    if not a.paths:
        st = d.read_state(TAG)
        if st and not d.pid_alive(st.get("pid")):
            d.clear_state(TAG)                          # 进程已经没了，清掉过期状态
            st = {}
        if st:
            print("tv-show 在跑：pid=%s，%s 张图，http://%s:%s/"
                  % (st.get("pid"), st.get("files"), d.local_ip(), st.get("port")))
        print("用法: tv-show 图片或目录... | tv-show off")
        return 0 if st else 2
    return start(a)


if __name__ == "__main__":
    sys.exit(main())
